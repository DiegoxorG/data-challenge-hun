# Copia este archivo como .env (setup lo hace solo) y llénalo con TUS datos.
# .env está en .gitignore: nunca se sube. Cada integrante tiene sus propias credenciales.

PGHOST=cambiar_host_que_da_el_HUN
PGPORT=5432
PGDATABASE=cambiar_nombre_bd
PGUSER=tu_usuario_hun
PGPASSWORD=
PGSCHEMA=uninorte_omop

# Carpeta local para extractos. DEBE estar FUERA del repo y fuera de
# OneDrive / Google Drive / iCloud / Dropbox. El código se niega a correr si no.
# Windows: C:\hun_data    macOS/Linux: /Users/tu_usuario/hun_data
DATA_DIR=
