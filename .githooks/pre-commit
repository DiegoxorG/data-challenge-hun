#!/bin/sh
# Hook anti-fuga: se activa con  git config core.hooksPath .githooks
# (lo hacen scripts/setup.ps1 o scripts/setup.sh)

ROOT="$(git rev-parse --show-toplevel)"

for PY in python3 python py; do
  if command -v "$PY" >/dev/null 2>&1 && "$PY" -c "import sys; sys.exit(sys.version_info < (3, 8))" >/dev/null 2>&1; then
    exec "$PY" "$ROOT/scripts/check_no_data.py" --staged
  fi
done

echo "✘ pre-commit: no encontré Python 3.8+; no puedo revisar el commit, así que lo bloqueo."
echo "  Instala Python o activa tu venv e intenta de nuevo."
exit 1
